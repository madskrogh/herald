{
  "swagger": "2.0",
  "info": {
    "title": "Herald Tenant API",
    "version": "v1"
  },
  "tags": [
    {
      "name": "ApplicationService",
      "description": "ApplicationService manages a Tenant's Applications."
    },
    {
      "name": "EndpointService",
      "description": "EndpointService manages the Endpoints registered under an Application."
    },
    {
      "name": "MessageService",
      "description": "MessageService accepts the Messages a Tenant sends to its Applications."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/applications": {
      "get": {
        "summary": "ListApplications returns the Tenant's Applications.",
        "operationId": "ApplicationService_ListApplications",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListApplicationsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "ApplicationService"
        ]
      },
      "post": {
        "summary": "CreateApplication creates an Application.",
        "operationId": "ApplicationService_CreateApplication",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateApplicationResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateApplicationRequest"
            }
          }
        ],
        "tags": [
          "ApplicationService"
        ]
      }
    },
    "/v1/applications/{application_id}/endpoints": {
      "get": {
        "summary": "ListEndpoints returns an Application's Endpoints, without their signing\nsecrets.",
        "operationId": "EndpointService_ListEndpoints",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListEndpointsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "EndpointService"
        ]
      },
      "post": {
        "summary": "CreateEndpoint registers an Endpoint and generates its signing secret. The\nresponse is the only time the signing secret is returned.",
        "operationId": "EndpointService_CreateEndpoint",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateEndpointResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EndpointServiceCreateEndpointBody"
            }
          }
        ],
        "tags": [
          "EndpointService"
        ]
      }
    },
    "/v1/applications/{application_id}/endpoints/{id}": {
      "get": {
        "summary": "GetEndpoint returns one Endpoint, without its signing secret.",
        "operationId": "EndpointService_GetEndpoint",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetEndpointResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "EndpointService"
        ]
      }
    },
    "/v1/applications/{id}": {
      "get": {
        "summary": "GetApplication returns one Application.",
        "operationId": "ApplicationService_GetApplication",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetApplicationResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ApplicationService"
        ]
      }
    },
    "/v1/messages": {
      "post": {
        "summary": "CreateMessage accepts a Message for one of the Tenant's Applications.\nHerald delivers it to each of the Application's Endpoints whose filter\nmatches its Event type.",
        "description": "An optional Idempotency-Key (an HTTP header, or gRPC metadata\n\"idempotency-key\") makes retrying safe: for 24 hours, another call with\nthe same key returns the Message the key was first sent with, and creates\nnothing. Keys are 1 to 256 bytes, and unique per Tenant.",
        "operationId": "MessageService_CreateMessage",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateMessageResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateMessageRequest"
            }
          },
          {
            "name": "Idempotency-Key",
            "description": "Makes retrying safe: for 24 hours, another call with the same key returns the Message the key was first sent with, and creates nothing. 1 to 256 bytes, unique per Tenant.",
            "in": "header",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "MessageService"
        ]
      }
    }
  },
  "definitions": {
    "EndpointServiceCreateEndpointBody": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "filter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Application": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "A name for the Tenant's own reference, such as the customer's name. It is\nnot blank, and at most 256 bytes."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Application is one of a Tenant's customers: the owner of a set of Endpoints."
    },
    "v1CreateApplicationRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "v1CreateApplicationResponse": {
      "type": "object",
      "properties": {
        "application": {
          "$ref": "#/definitions/v1Application"
        }
      }
    },
    "v1CreateEndpointResponse": {
      "type": "object",
      "properties": {
        "endpoint": {
          "$ref": "#/definitions/v1Endpoint"
        },
        "signing_secret": {
          "type": "string",
          "description": "The secret Herald signs webhooks to this Endpoint with (Standard Webhooks,\n\"whsec_\" prefix). It is returned only here, so store it now."
        }
      }
    },
    "v1CreateMessageRequest": {
      "type": "object",
      "properties": {
        "application_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "payload": {
          "type": "string"
        }
      }
    },
    "v1CreateMessageResponse": {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/definitions/v1Message"
        }
      }
    },
    "v1Endpoint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "application_id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "description": "An absolute http or https URL with a host and, if any, a port from 1 to\n65535. At most 2048 bytes, without user information, a fragment or\nunescaped whitespace."
        },
        "filter": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The Event types the Endpoint accepts, as patterns: Event types in which\nany token may be \"*\", which matches exactly one token, and whose last\ntoken may be \"\u003e\", which matches one or more tokens. An empty filter\naccepts every Event type. At most 32 patterns, each at most 128 bytes."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Endpoint is a URL registered under an Application, to which Herald delivers\nwebhooks. Its URL and filter can't be changed after it is created."
    },
    "v1GetApplicationResponse": {
      "type": "object",
      "properties": {
        "application": {
          "$ref": "#/definitions/v1Application"
        }
      }
    },
    "v1GetEndpointResponse": {
      "type": "object",
      "properties": {
        "endpoint": {
          "$ref": "#/definitions/v1Endpoint"
        }
      }
    },
    "v1ListApplicationsResponse": {
      "type": "object",
      "properties": {
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Application"
          }
        },
        "next_page_token": {
          "type": "string"
        }
      }
    },
    "v1ListEndpointsResponse": {
      "type": "object",
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Endpoint"
          }
        },
        "next_page_token": {
          "type": "string"
        }
      }
    },
    "v1Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "application_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string",
          "description": "Dot-separated tokens of lowercase letters, digits and underscores, such\nas \"invoice.paid\". At most 128 bytes."
        },
        "payload": {
          "type": "string",
          "description": "A JSON document, at most 256 KiB, as text. Herald delivers it byte for\nbyte as sent; it is never parsed and re-encoded, so no number loses\nprecision and no key changes order."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Message is a single notification for one Application: an Event type and a\npayload."
    }
  },
  "securityDefinitions": {
    "ApiKey": {
      "type": "apiKey",
      "description": "One of the Tenant's API keys, as \"Bearer \u003ckey\u003e\".",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
      "ApiKey": []
    }
  ]
}
